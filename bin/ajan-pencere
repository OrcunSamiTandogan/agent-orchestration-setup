KEY = re.compile(r"nvapi-[A-Za-z0-9_.-]{8,500}")


def source_version():
    try:
        return subprocess.check_output(
            ["bash", str(ROOT / "bin/ajan-surum"), "--display"], text=True, timeout=4
        ).strip()
    except (OSError, subprocess.SubprocessError):
        return "Version or build unknown"


def config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ajan-atolyesi"


PROVIDERS = {
    "NVIDIA_API_KEY": ("NVIDIA", KEY),
    "EVREN_API_KEY": ("EVREN", re.compile(r"[!-~]{8,512}")),
}


def read_keys():
    try:
        fd = os.open(config_dir() / ".env", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return {}
    with os.fdopen(fd, "r", encoding="ascii") as handle:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600:
            raise OSError("The .env file must be readable only by its owner (0600).")
        content = handle.read(2049)
        if len(content) > 2048:
            raise ValueError("The app's .env file has an unexpected format.")
        result = {}
        for line in content.splitlines():
            variable, sep, key = line.partition("=")
            if (not sep or variable in result or variable not in PROVIDERS
                    or not PROVIDERS[variable][1].fullmatch(key)):
                raise ValueError("The app's .env file has an unexpected format.")
            result[variable] = key
        return result


def save_key(key, variable="NVIDIA_API_KEY"):
    name, pattern = PROVIDERS[variable]
    if not pattern.fullmatch(key):
        raise ValueError(f"Enter a valid {name} API key.")
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = directory.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise OSError("A secure settings directory is required.")
    values = read_keys()
    values[variable] = key
    fd, tmp = tempfile.mkstemp(prefix=".provider-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="ascii") as handle:
            for variable, value in sorted(values.items()):
                handle.write(f"{variable}={value}\n")
        os.replace(tmp, directory / ".env")
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def saved_key(variable="NVIDIA_API_KEY"):
    return read_keys().get(variable)


def key_file_status():
    try:
        saved = read_keys()
    except (OSError, ValueError):
        return {provider: "Unreadable" for provider in PROVIDERS}
    return {provider: "Saved" if provider in saved else "Not yet entered"
            for provider in PROVIDERS}


def note_shell(note):
    return ["/bin/bash", "--noprofile", "--norc", "-c",
            'printf "%s\\n\\n" "$1"; exec /bin/bash --noprofile --norc -i',
            "ajan-atolyesi", note]


def agent_for(role):
    agent = role.removeprefix("setup-")
    return agent if agent in ("claude", "codex") else None


def tmux_role(role):
    return role if role in ("pi", "evren-cli") else agent_for(role)


ATOLYE_TMUX_NAMES = ("aa-codex", "aa-claude", "aa-pi", "aa-evren-cli", "aa-codex-atolye", "aa-claude-atolye")
TMUX_FULL = {"codex": "aa-codex-tam", "claude": "aa-claude-tam"}
TMUX_ALTERNATES = {"codex": "aa-codex-atolye", "claude": "aa-claude-atolye"}
PUBLIC_TMUX_OWNER = "ajan-atolyesi-public-v1"


def tmux_candidates():
    tmux = shutil.which("tmux")
    if not tmux:
        return {}
    try:
        result = subprocess.run([tmux, "list-sessions", "-F", "#{session_name} #{session_id}"],
                                capture_output=True, text=True, timeout=0.8)
    except (OSError, subprocess.SubprocessError):
        return {}
    sessions = {}
    if result.returncode == 0:
        for line in result.stdout.splitlines():
            name, _, session_id = line.partition(" ")
            if (name in ATOLYE_TMUX_NAMES or name in TMUX_FULL.values()) and re.fullmatch(r"\$[0-9]+", session_id):
                sessions[name] = (tmux, session_id)
    return sessions


def trusted_session(name, target, mode="normal"):
    binary, session_id = target
    for variable, expected in (("AA_ATOLYE_OWNER", PUBLIC_TMUX_OWNER),
                               ("AA_SETUP_MODE", mode)):
        try:
            result = subprocess.run([binary, "show-environment", "-t", session_id, variable],
                                    capture_output=True, text=True, timeout=0.8)
        except (OSError, subprocess.SubprocessError):
            return False
        if result.returncode or result.stdout.rstrip("\n") != f"{variable}={expected}":
            return False
    return True


def atolye_sessions():
    return {name: target for name, target in tmux_candidates().items()
            if trusted_session(name, target)}


def resolve_session(agent, mode="normal"):
    if mode == "full":
        name = TMUX_FULL.get(agent)
        if not name:
            return "absent", "", None
        target = tmux_candidates().get(name)
        if target is None:
            return "absent", name, None
        return ("trusted", name, target) if trusted_session(name, target, "full") else ("blocked", name, None)
    name = f"aa-{agent}"
    if name not in ATOLYE_TMUX_NAMES or name in TMUX_ALTERNATES.values():
        return "absent", name, None
    candidates = tmux_candidates()
    target = candidates.get(name)
    if target is not None and trusted_session(name, target):
        return "trusted", name, target
    alternate = TMUX_ALTERNATES.get(agent)
    if alternate:
        alternate_target = candidates.get(alternate)
        if alternate_target is not None and trusted_session(alternate, alternate_target):
            return "trusted", alternate, alternate_target
        if target is not None and alternate_target is None:
            return "alternate", alternate, None
    return ("blocked", name, None) if target is not None else ("absent", name, None)


def session_attachment(agent):
    state, _, target = resolve_session(agent)
    return state, target


def named_session(agent):
    return resolve_session(agent)[2]


PI_TRUST_NOTICE = (
    "Pi and the tools it runs can access your NVIDIA API key. "
    "Instructions in the folder and content you submit may be sent to NVIDIA. "
    "Only open your own code or a folder you trust. "
    "For your first run, use the bundled sample folder. Do not paste keys into chat."
)


def session_reminder(sessions):
    live = ", ".join(name for name in ATOLYE_TMUX_NAMES if name in sessions)
    return (
        "Agent Orchestration Setup session reminder\n\n"
        f"Detected tmux targets: {live or 'no verified open targets'}.\n"
        "Possible targets: aa-codex (Codex), aa-claude (Claude), aa-pi (Pi), "
        "aa-evren-cli (DSH CLI). If names conflict, a verified aa-codex-atolye or "
        "aa-claude-atolye can be used. DSH Web and the standalone Terminal are not tmux targets.\n\n"
        "Send a message only when the user asks you to contact another session. "
        "First recheck the exact name and open pane on the default tmux server. "
        "The selected project folder can differ from the open pane's folder. Verify both if needed. "
        "Do not switch to a similarly named session, a test session, or a session on another server. "
        "An open tmux session does not mean its agent is ready for input. "
        "Stop and tell the user if the target is uncertain or busy.\n\n"
        "Send the message once to the verified target. Delivery to the pane "
        "does not mean the reply is complete. Do not report completion without seeing new output or an error. "
        "Do not resend automatically after a short wait."
    )


def session_pane_path(target):
    if not target:
        return None
    binary, session_id = target
    try:
        result = subprocess.run([binary, "display-message", "-p", "-t", session_id,
                                 "#{pane_current_path}"],
                                capture_output=True, text=True, timeout=0.8)
    except (OSError, subprocess.SubprocessError):
        return None
    path = result.stdout.rstrip("\n")
    return path if result.returncode == 0 and path.startswith("/") and "\n" not in path else None


def session_command(role, mode="normal", setup_selection=None, session_id=None):
    if mode not in ("normal", "existing", "full"):
        raise ValueError("Invalid permission mode")
    if mode == "full" and role not in ("claude", "codex"):
        raise ValueError("Full access is available only from a standard agent row")
    setup = role in ("setup-claude", "setup-codex") and mode != "existing"
    if (setup and setup_selection not in ("pi", "evren", "both")) or (not setup and setup_selection is not None):
        raise ValueError("Select at least one tool to verify")
    if session_id is not None and (mode != "existing" or not (agent_for(role) or role in ("pi", "evren-cli"))
                                   or not re.fullmatch(r"\$[0-9]+", session_id)):
        raise ValueError("Invalid session ID")
    if role == "evren-cli" and mode in ("normal", "existing"):
        if mode == "existing" and session_id is None:
            raise ValueError("A DSH CLI tmux session ID is required")
        return [str(ROOT / "bin/ajan-dsh-pane")] + ([session_id] if session_id else [])
    if role == "pi":
        if mode == "existing" and session_id is None:
            raise ValueError("A Pi tmux session ID is required")
        return [sys.executable, str(Path(__file__).resolve()), "--pi-tmux"] + (
            [session_id] if session_id else [])
    agent = agent_for(role)
    if agent:
        return [str(ROOT / "bin/ajan-kur"), agent, mode,
                "setup" if setup else "plain"] + (
                    [setup_selection] if setup else [session_id] if session_id else [])
    if mode != "normal":
        raise ValueError("This session cannot change its permission mode")
    if role == "evren":
        return [sys.executable, str(ROOT / "bin/evren-dsh-terminal")]
    if role == "terminal":
        shell = os.environ.get("SHELL", "")
        if not Path(shell).is_absolute() or not Path(shell).is_file() or not os.access(shell, os.X_OK):
            shell = "/bin/bash"
        return [shell, "-i"]
    raise ValueError("Unknown session")


def add_nvidia_models(directory):
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = directory / "models.json"
    if path.is_symlink():
        raise OSError("The model settings file cannot be a symbolic link.")
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        settings = {}
    if not isinstance(settings, dict):
        raise ValueError("The model settings file has an unexpected format.")
    providers = settings.setdefault("providers", {})
    if not isinstance(providers, dict):
        raise ValueError("The model provider settings have an unexpected format.")
    nvidia = providers.setdefault("nvidia", {})
    if not isinstance(nvidia, dict) or nvidia.get("baseUrl", NVIDIA_URL) != NVIDIA_URL:
        raise ValueError("The NVIDIA provider address has changed.")
    models = nvidia.setdefault("models", [])
    if not isinstance(models, list) or not all(isinstance(m, dict) for m in models):
        raise ValueError("The NVIDIA model list has an unexpected format.")
    bundled = {
        KIMI_ID: ("Kimi K3.1 Pro", 1000000),
        MINIMAX_ID: ("MiniMax M3.1 Flash", 262144),
    }
    changed = False
    for model_id, (name, context_window) in bundled.items():
        existing = next((m for m in models if m.get("id") == model_id), None)
        if existing is not None:
            if existing.get("baseUrl", NVIDIA_URL) != NVIDIA_URL:
                raise ValueError("An NVIDIA model is configured with a different provider address.")
            continue
        models.append({"id": model_id, "name": name,
                       "baseUrl": NVIDIA_URL, "api": "openai-completions",
                       "input": ["text", "image"], "reasoning": True,
                       "contextWindow": context_window, "maxTokens": 16384})
        changed = True
    if not changed:
        return
    fd, tmp = tempfile.mkstemp(prefix=".models-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(settings, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def pi_prefix():
    return config_dir() / "pi-install"


def pi_binary():
    local = pi_prefix() / "bin/pi"
    return str(local) if local.is_file() and os.access(local, os.X_OK) else shutil.which("pi")


def dsh_prefix():
    return config_dir() / "dsh-install"


def dsh_binary():
    local = dsh_prefix() / "bin/dsh"
    return str(local) if local.is_file() and os.access(local, os.X_OK) else shutil.which("dsh")


def npm_install_command(prefix, package, min_version):
    node, npm = shutil.which("node"), shutil.which("npm")
    if not (node and npm):
        return None
    try:
        version = subprocess.check_output([node, "--version"], text=True, timeout=2).strip()
    except (OSError, subprocess.SubprocessError):
        return None
    match = re.fullmatch(r"v(\d+)\.(\d+)\.(\d+)", version)
    if not match or tuple(map(int, match.groups())) < min_version:
        return None
    return [npm, "install", "-g", "--ignore-scripts", "--no-audit", "--no-fund",
            "--registry=https://registry.npmjs.org/", "--globalconfig=/dev/null",
            "--fetch-retries=0", "--fetch-timeout=60000", "--prefix", str(prefix), package]


def installed_package_ready(prefix, binary, package, env):
    path = prefix / "bin" / binary
    if not path.is_file() or not os.access(path, os.X_OK):
        return False
    try:
        version = subprocess.check_output([str(path), "--version"], text=True,
                                          stderr=subprocess.DEVNULL, env=env, timeout=3).strip()
    except (OSError, subprocess.SubprocessError):
        return False
    return version == package.rsplit("@", 1)[-1]


def pi_install_command():
    return npm_install_command(pi_prefix(), PI_PACKAGE, (22, 19, 0))


def dsh_install_command():
    return npm_install_command(dsh_prefix(), DSH_PACKAGE, (24, 9, 0))


def pi_tmux(expected_id=None):
    tmux = shutil.which("tmux")
    if not tmux:
        print("Install tmux before opening Pi.", file=sys.stderr)
        return 1
    # Only the Pi process inside the pane reads its saved provider key.
    keep = ("HOME", "USER", "LOGNAME", "PATH", "SHELL", "TERM", "COLORTERM",
            "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR", "TMP", "TEMP",
            "TMUX", "TMUX_TMPDIR", "XDG_CONFIG_HOME")
    env = {name: os.environ[name] for name in keep if name in os.environ}
    attachment, target = session_attachment("pi")
    if expected_id is None:
        if attachment != "absent":
            print("aa-pi opened in the meantime. Check the project folder and try again.", file=sys.stderr)
            return 1
        result = subprocess.run(
            [tmux, "new-session", "-d", "-E", "-P", "-F", "#{session_id}",
             "-s", "aa-pi", "-c", os.getcwd(),
             "-e", f"AA_ATOLYE_OWNER={PUBLIC_TMUX_OWNER}", "-e", "AA_SETUP_MODE=normal",
             "-e", f"PATH={env.get('PATH', os.defpath)}",
             "-e", f"XDG_CONFIG_HOME={env.get('XDG_CONFIG_HOME', '')}",
             sys.executable, str(Path(__file__).resolve()), "--pi-terminal"],
            env=env, capture_output=True, text=True)
        if result.returncode == 0:
            expected_id = result.stdout.strip()
            attachment, target = session_attachment("pi")
    if attachment != "trusted" or (expected_id is not None and target[1] != expected_id):
        print("Could not verify the aa-pi session. Reopen Pi.", file=sys.stderr)
        return 1
    command = "switch-client" if env.get("TMUX") else "attach-session"
    os.execve(tmux, [tmux, command, "-E", "-t", target[1]], env)


def pi_terminal():
    # The tmux server can predate this launch and have its own global environment.
    keep = ("HOME", "USER", "LOGNAME", "PATH", "SHELL", "TERM", "COLORTERM",
            "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR", "TMP", "TEMP")
    env = {name: os.environ[name] for name in keep if name in os.environ}
    binary = pi_binary()
    if not binary:
        args = note_shell("Pi is not installed. Setup guide: https://docs.pi.dev/latest/quickstart")
        os.execve(args[0], args, env)
    try:
        key = saved_key()
    except (OSError, ValueError):
        args = note_shell("Could not read the NVIDIA settings. See API keys for the file location. Troubleshooting: " + FAQ_URL)
        os.execve(args[0], args, env)
    if not key:
        args = note_shell("Save your NVIDIA API key in Agent Orchestration Setup, then select Pi again.")
        return os.execve(args[0], args, env)
    directory = config_dir() / "pi"
    try:
        add_nvidia_models(directory)
    except (OSError, ValueError):
        args = note_shell("Could not add NVIDIA model settings. The existing file was left unchanged.")
        return os.execve(args[0], args, env)
    env["NVIDIA_API_KEY"] = key
    env["PI_CODING_AGENT_DIR"] = str(directory)
    return os.execve(binary, [binary, "--models", NVIDIA_SCOPE, "--model", "nvidia/" + MINIMAX_ID, "--thinking", "low", "--no-extensions"], env)


def session_icons():
    path = config_dir() / "appearance.json"
    if path.is_symlink():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return {}
    if not isinstance(value, dict):
        return {}
    roles, icons = dict(OPTIONS).values(), dict(ICONS).values()
    return {role: icon for role, icon in value.items() if role in roles and icon in icons}


def save_session_icon(role, icon):
    if role not in dict(OPTIONS).values() or (icon is not None and icon not in dict(ICONS).values()):
        raise ValueError("Unknown session or icon")
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    st = directory.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise OSError("Could not use the settings folder.")
    values = session_icons()
    if icon is None:
        values.pop(role, None)
    else:
        values[role] = icon
    fd, tmp = tempfile.mkstemp(prefix=".appearance-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(values, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(tmp, directory / "appearance.json")
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


DESKTOP_CSS = b"""
.aa-caption { font-size: 0.91em; }
button.aa-row { padding: 5px 10px; min-height: 25px; }
button.aa-row.aa-selected { font-weight: bold; box-shadow: inset 2px 0 @theme_selected_bg_color; }
button.aa-close { min-width: 22px; padding: 3px 4px; }
"""


def make_window(Gtk, Vte, Gio, GLib, smoke_terminal=False):
    win = Gtk.Window(title="Agent Orchestration Setup")
    win.set_wmclass("ajan-atolyesi", "ajan-atolyesi")
    win.set_default_size(1000, 650)
    win.connect("destroy", Gtk.main_quit)
    from gi.repository import Gdk, GdkPixbuf
    icon_path = str(ROOT / "assets/ajan-atolyesi.svg")
    try:
        win.set_icon_from_file(icon_path)
        brand_icon = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 25, 25, True)
    except GLib.Error:
        brand_icon = None
    css = Gtk.CssProvider()
    css.load_from_data(DESKTOP_CSS)
    Gtk.StyleContext.add_provider_for_screen(win.get_screen(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    layout = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    win.add(layout)

    left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
    left.set_border_width(12)
    left.set_size_request(240, -1)

    def set_row_icon(button, name):
        image = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
        image.set_margin_end(8)
        button.set_image(image)
        button.set_always_show_image(True)

    def row_button(label, icon=None, setup=False):
        button = Gtk.Button(label=label)
        style = button.get_style_context()
        style.add_class("aa-row")
        style.add_class("flat")
        if setup:
            style.add_class("aa-setup")
        if icon:
            set_row_icon(button, icon)
        button.set_alignment(0.0, 0.5)
        return button
    layout.pack_start(left, False, False, 0)
    layout.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)

    brand = Gtk.Box(spacing=8)
    glyph = (Gtk.Image.new_from_pixbuf(brand_icon) if brand_icon is not None
             else Gtk.Image.new_from_icon_name("utilities-terminal-symbolic", Gtk.IconSize.BUTTON))
    brand.pack_start(glyph, False, False, 0)
    title = Gtk.Label(xalign=0)
    title.set_markup("<b>Agent Orchestration Setup</b>")
    brand.pack_start(title, True, True, 0)
    reminder_button = Gtk.Button()
    reminder_button.set_image(Gtk.Image.new_from_icon_name("document-edit-symbolic", Gtk.IconSize.BUTTON))
    reminder_button.get_style_context().add_class("flat")
    reminder_button.set_tooltip_text("Session reminder")
    reminder_button.get_accessible().set_name("Session reminder")
    brand.pack_end(reminder_button, False, False, 0)
    about_button = Gtk.Button()
    about_button.set_image(Gtk.Image.new_from_icon_name("dialog-information-symbolic", Gtk.IconSize.BUTTON))
    about_button.get_style_context().add_class("flat")
    about_button.set_tooltip_text("About Agent Orchestration Setup")
    about_button.get_accessible().set_name("About Agent Orchestration Setup")
    brand.pack_end(about_button, False, False, 0)

    def show_about(_button):
        dialog = Gtk.AboutDialog(transient_for=win, modal=True)
        dialog.set_program_name("Agent Orchestration Setup")
        dialog.set_version(source_version())
        dialog.set_comments(ABOUT_TEXT)
        dialog.set_website(REPO_URL)
        dialog.set_website_label("GitHub repository and setup guide")
        try:
            logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 80, 80, True)
        except GLib.Error:
            pass
        else:
            dialog.set_logo(logo)
        dialog.run()
        dialog.destroy()

    about_button.connect("clicked", show_about)
    left.pack_start(brand, False, False, 9)
