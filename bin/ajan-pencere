    evren_setup = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                         halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    evren_setup.pack_start(Gtk.Label(label="Provider: EVREN · Model: DeepSeek V4.1 Flash"), False, False, 0)
    evren_detail = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
    evren_setup.pack_start(evren_detail, False, False, 0)
