    install_pi_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    install_pi_page.pack_start(Gtk.Label(label="Pi was not found on this computer."), False, False, 0)
